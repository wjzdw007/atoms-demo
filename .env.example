# Copy to .env.local and fill in. Every variable is read on the server only (src/lib/config.ts);
# never prefix any of them with NEXT_PUBLIC_, and never commit real values.
# With nothing set the app still runs, in "demo mode" with canned output.

# ---------------------------------------------------------------------------------------------
# Model service: any OpenAI-compatible endpoint (defaults are for Tencent Cloud TokenHub)
# ---------------------------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://tokenhub.tencentmaas.com/plan/v3
# Model that writes the app, and the default choice in the model picker
LLM_MODEL=glm-5.3
# Optional free tier: when set, the daily free allowance only covers these models (comma-separated;
# the first is the default), and every other model in LLM_MODELS costs one credit per generation.
# LLM_FREE_MODEL=deepseek-v4.1-flash-1017,deepseek/deepseek-flash
# Models users may pick, as id=label pairs. The server refuses anything not listed here.
# LLM_MODELS=glm-5.3=均衡 · GLM-5.3,glm-5.3-flash=更快 · GLM-5.3 Flash,kimi-k3=长输出 · Kimi K3
# Optional fixed models for planning and review (default: the model chosen for the run)
# LLM_PLANNER_MODEL=
# LLM_REVIEWER_MODEL=
# low | medium | high. With "low" code starts streaming within seconds; many models otherwise
# reason silently for a minute or more first.
# LLM_REASONING_EFFORT=low
# Models whose reasoning is switched off completely (regex on the model id). DeepSeek and GLM-5.2
# ignore "low" effort on TokenHub and reason for minutes unless disabled this way.
# LLM_NO_THINKING_MODELS=deepseek|glm-5\.2
# Output cap per call. Unset = no artificial cap (the model's own maximum is used).
# LLM_MAX_TOKENS=
# Largest prompt (characters) sent to the engineer before the user is asked to split the app
# LLM_MAX_CONTEXT_CHARS=400000

# ---------------------------------------------------------------------------------------------
# Agent pipeline
# ---------------------------------------------------------------------------------------------
# Race mode: the same request built by 2-3 models side by side; the user keeps one. Each lane is
# charged like a normal generation on that model. Set RACE_MODE=off to hide it.
# RACE_MODE=on
# RACE_MAX_LANES=3
# off: no review | report: review and show findings | fix: also let the engineer fix them once
# REVIEW_MODE=fix
# A model call is given up on (and refunded) once it has sent nothing, not even reasoning, for
# this many seconds. A model that is still writing is never cut off for being slow.
# GENERATION_IDLE_SECONDS=120
# Safety ceiling for one whole generation job
# GENERATION_TIMEOUT_SECONDS=1800

# ---------------------------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------------------------
# Required in production: openssl rand -hex 32
AUTH_SECRET=
# SESSION_DAYS=30
# Public origin of the site; used for the Google OAuth callback URL
# APP_URL=https://your-domain.com
# Set to 1 only while the site is served over plain http (otherwise the login cookie is dropped)
# ALLOW_HTTP=1

# Contact address shown on the privacy page for account-deletion requests
# CONTACT_EMAIL=

# ---------------------------------------------------------------------------------------------
# Database: a SQLite file by default; a hosted libSQL database (Turso) for serverless
# ---------------------------------------------------------------------------------------------
# DATABASE_URL=libsql://<db>.turso.io
# DATABASE_AUTH_TOKEN=

# ---------------------------------------------------------------------------------------------
# Quota, credits and billing
# ---------------------------------------------------------------------------------------------
# Free generations per day
# DAILY_FREE_GUEST=3
# DAILY_FREE_USER=10
# Free generations per day shared by all guest accounts behind one IP address
# DAILY_FREE_PER_IP=15
# Most generations one account may run per day, free and paid together
# DAILY_MAX_PER_USER=100
# Site-wide ceiling per day across all users, free or paid: bounds the model bill
# SITE_DAILY_GENERATION_LIMIT=500
# off (default): no purchases
# manual: users place orders; credits arrive only after an administrator confirms payment
#         through the admin API (needs ADMIN_TOKEN)
# mock:   orders confirm themselves with no payment. Local demos only; never on a public site.
# BILLING_MODE=off
# Shown to buyers in manual mode: how to pay and whom to contact
# BILLING_PAYMENT_NOTE=
# Bearer token for /api/admin/*. Unset = the admin API does not exist. openssl rand -hex 24
# ADMIN_TOKEN=
# BILLING_MAX_BALANCE=1000

# ---------------------------------------------------------------------------------------------
# Storage limits
# ---------------------------------------------------------------------------------------------
# MAX_VERSIONS_PER_PROJECT=50
# MAX_PROJECTS_PER_USER=100
# MAX_HTML_BYTES=800000
# MAX_APP_DATA_BYTES=500000

# ---------------------------------------------------------------------------------------------
# Abuse protection (per client IP)
# ---------------------------------------------------------------------------------------------
# RATE_LIMIT_AUTH=20
# New guest accounts per IP per hour
# RATE_LIMIT_GUESTS=20

# ---------------------------------------------------------------------------------------------
# Google sign-in: the only way to sign in (without it everyone stays a guest)
# Redirect URI to register with Google: <APP_URL>/api/auth/google/callback
# ---------------------------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# When the server cannot reach Google directly, connect to a local TCP relay instead
# (see deploy/google-relay.service.example). TLS names and certificate checks are unchanged.
# GOOGLE_OAUTH_CONNECT=127.0.0.1:8445
# GOOGLE_APIS_CONNECT=127.0.0.1:8446
