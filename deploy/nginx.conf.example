# nginx site for the app. Replace the domain and certificate paths.
server {
    listen 443 ssl;
    server_name atoms.example.com;

    ssl_certificate     /etc/letsencrypt/live/atoms.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/atoms.example.com/privkey.pem;

    # Requests are small JSON bodies; reject anything larger before it reaches the app.
    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Overwrite (not append) so the app's rate limiter cannot be fed a spoofed client address.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Generation progress is streamed; do not buffer it.
        proxy_buffering off;
        proxy_read_timeout 900s;
    }
}

# Port 80: redirect to https (so the bare domain works when typed), and serve certificate renewal
# challenges from a webroot (certbot: authenticator = webroot, webroot_path = /var/www/acme).
server {
    listen 80;
    server_name atoms.example.com;
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://atoms.example.com$request_uri; }
}
